# Generate a local .env with: python -m central_brain.manage init-local
ENVIRONMENT=local
PUBLIC_URL=http://127.0.0.1:8080
DATABASE_URL=postgresql://central_brain_runtime:REPLACE@127.0.0.1:55432/central_brain
MIGRATION_DATABASE_URL=postgresql://central_brain_migrator:REPLACE@127.0.0.1:55432/central_brain
LOCAL_ADMIN_URL=postgresql://postgres:REPLACE@127.0.0.1:55432/postgres
LOCAL_POSTGRES_PASSWORD=REPLACE
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CENTRAL_BRAIN_PRINCIPALS_JSON={}
OAUTH_PRINCIPALS_JSON={}
OAUTH_ISSUER=
OAUTH_CLIENT_IDS=[]
OAUTH_WEB_CLIENT_ID=
OAUTH_WEB_CLIENT_SECRET=
OAUTH_SCOPE_PREFIX=central-brain
MAX_SEARCH_RESULTS=20
MAX_CONTEXT_CHARS=16000
