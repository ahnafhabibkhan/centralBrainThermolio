# Local development only. Store production values in AWS Secrets Manager.
DATABASE_URL=postgresql://central_brain:change-me@localhost:5432/central_brain
# JSON mapping opaque bearer tokens to trusted workspace/actor identities.
# Store this value in AWS Secrets Manager in production.
CENTRAL_BRAIN_PRINCIPALS_JSON={"replace-with-at-least-32-random-characters":{"workspace_id":"00000000-0000-0000-0000-000000000001","actor_id":"00000000-0000-0000-0000-000000000001","roles":["reviewer"]}}
CENTRAL_BRAIN_SCHEMA=central_brain
LOG_LEVEL=info
