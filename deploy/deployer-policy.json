{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentState",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "cognito-idp:ListUserPools",
        "ssm:DescribeInstanceInformation",
        "pricing:GetProducts",
        "freetier:GetFreeTierUsage",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudformation:ListStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProjectEncryptedConfiguration",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameter", "ssm:DeleteParameter", "ssm:AddTagsToResource"],
      "Resource": "arn:aws:ssm:ca-central-1:596104703378:parameter/central-brain/pilot/environment"
    },
    {
      "Sid": "ProjectCostTagSetup",
      "Effect": "Allow",
      "Action": ["ce:ListCostAllocationTags", "ce:UpdateCostAllocationTagsStatus"],
      "Resource": "*"
    },
    {
      "Sid": "ProjectStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:DeleteStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:ListChangeSets"
      ],
      "Resource": "arn:aws:cloudformation:ca-central-1:596104703378:stack/central-brain-*/*"
    },
    {
      "Sid": "ValidateTemplates",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadAmazonImageParameter",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:ca-central-1::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "CreateProjectEC2",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateVolume",
        "ec2:AllocateAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ca-central-1",
          "aws:RequestTag/Project": "CentralBrain"
        }
      }
    },
    {
      "Sid": "CreateGroupInSelectedVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:ca-central-1:596104703378:vpc/vpc-001b383be7a969294"
    },
    {
      "Sid": "LaunchProjectInstance",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ca-central-1:596104703378:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CentralBrain",
          "ec2:InstanceType": "t4g.small"
        }
      }
    },
    {
      "Sid": "LaunchDependencies",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ca-central-1::image/*",
        "arn:aws:ec2:ca-central-1:596104703378:volume/*",
        "arn:aws:ec2:ca-central-1:596104703378:network-interface/*",
        "arn:aws:ec2:ca-central-1:596104703378:security-group/*",
        "arn:aws:ec2:ca-central-1:596104703378:subnet/subnet-058870551a5c4e29d"
      ]
    },
    {
      "Sid": "ManageProjectEC2",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup",
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:StartInstances",
        "ec2:RebootInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceCreditSpecification",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:ca-central-1:596104703378:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Project": "CentralBrain"
        }
      }
    },
    {
      "Sid": "TagNewEC2",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:ca-central-1:596104703378:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSecurityGroup",
            "AllocateAddress"
          ]
        }
      }
    },
    {
      "Sid": "ProjectInstanceRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:TagInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::596104703378:role/central-brain-pilot-*",
        "arn:aws:iam::596104703378:instance-profile/central-brain-pilot-*"
      ]
    },
    {
      "Sid": "PassOnlyProjectRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::596104703378:role/central-brain-pilot-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "budgets.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ProjectStorage",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketTagging",
        "s3:GetBucketTagging",
        "s3:PutBucketVersioning",
        "s3:GetBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutLifecycleConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::central-brain-pilot-*",
        "arn:aws:s3:::central-brain-pilot-*/*"
      ]
    },
    {
      "Sid": "CreateProjectLogin",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CentralBrain"
        }
      }
    },
    {
      "Sid": "ManageProjectLogin",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:GetUserPoolMfaConfig",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "cognito-idp:ListTagsForResource",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:UpdateUserPoolDomain",
        "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:CreateResourceServer",
        "cognito-idp:DescribeResourceServer",
        "cognito-idp:UpdateResourceServer",
        "cognito-idp:DeleteResourceServer",
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminGetUser",
        "cognito-idp:AdminSetUserPassword",
        "cognito-idp:AdminDeleteUser",
        "cognito-idp:ListUsers"
      ],
      "Resource": "arn:aws:cognito-idp:ca-central-1:596104703378:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "CentralBrain"
        }
      }
    },
    {
      "Sid": "DescribeLoginDomain",
      "Effect": "Allow",
      "Action": "cognito-idp:DescribeUserPoolDomain",
      "Resource": "*"
    },
    {
      "Sid": "ProjectNotifications",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource",
        "sns:Subscribe",
        "sns:ListSubscriptionsByTopic"
      ],
      "Resource": "arn:aws:sns:ca-central-1:596104703378:central-brain-pilot-*"
    },
    {
      "Sid": "ProjectAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudwatch:ca-central-1:596104703378:alarm:central-brain-pilot-*"
    },
    {
      "Sid": "CheckBudgetFreeAllowance",
      "Effect": "Allow",
      "Action": ["budgets:ViewBudget", "budgets:DescribeBudgetActionsForAccount"],
      "Resource": "*"
    },
    {
      "Sid": "ProjectBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "budgets:CreateBudgetAction",
        "budgets:DescribeBudgetAction",
        "budgets:DescribeBudgetActionsForBudget",
        "budgets:UpdateBudgetAction",
        "budgets:DeleteBudgetAction",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::596104703378:budget/central-brain-pilot*"
    },
    {
      "Sid": "RunProjectCommands",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:ca-central-1:596104703378:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "CentralBrain"
        }
      }
    },
    {
      "Sid": "RunOfficialCommandDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:ca-central-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommands",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
